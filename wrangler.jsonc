{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-new",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "192bcac3-8d88-450f-bc32-dbd092fafaa1","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0c6cd468789c4793ab3e0c343e333169" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
